# Copy this file to .env.local for local development, and set the same
# values in your deployment platform's environment variable settings.
# See README.md for how to get these from Supabase and where to deploy.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project settings -> API -> service_role key. Server-only. Never
# prefix this with NEXT_PUBLIC_ or it will be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL this app is deployed at (used to render the /api/leads
# endpoint URL in Settings -> Website Integration).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The college's display name, shown in the student dashboard. Optional.
NEXT_PUBLIC_COLLEGE_NAME=The College

# Optional but recommended once you're live: comma-separated list of
# origins allowed to call /api/leads from a browser. See
# docs/WEBSITE-INTEGRATION.md. Leave unset in local development.
# LEAD_CAPTURE_ALLOWED_ORIGINS=https://www.thecollege.edu,https://thecollege.edu
